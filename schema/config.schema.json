{
  "$defs": {
    "Action": {
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Focus the next window of the focused app.",
          "properties": {
            "type": {
              "const": "window.next",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Focus the previous window of the focused app.",
          "properties": {
            "type": {
              "const": "window.prev",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Focus the most recently used window of the next app.",
          "properties": {
            "type": {
              "const": "app.next",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Focus the most recently used window of the previous app.",
          "properties": {
            "type": {
              "const": "app.prev",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Wait before the next action in the chain.",
          "properties": {
            "ms": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "type": {
              "const": "delay",
              "type": "string"
            }
          },
          "required": [
            "type",
            "ms"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Run a program, detached from the daemon.",
          "properties": {
            "command": {
              "$ref": "#/$defs/ExecCommand"
            },
            "shell": {
              "default": false,
              "description": "Run a command string through the shell. Required for a string,\nrejected for an argument list.",
              "type": "boolean"
            },
            "type": {
              "const": "exec",
              "type": "string"
            }
          },
          "required": [
            "type",
            "command"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Send a keyboard shortcut to the focused window, e.g. `\"Ctrl+W\"`. The\nmodifiers the trigger itself is held with are released for it.",
          "properties": {
            "keys": {
              "type": "string"
            },
            "type": {
              "const": "keys",
              "type": "string"
            }
          },
          "required": [
            "type",
            "keys"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Minimize the focused window.",
          "properties": {
            "type": {
              "const": "window.minimize",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Maximize the focused window.",
          "properties": {
            "type": {
              "const": "window.maximize",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Restore the focused window from maximized or fullscreen.",
          "properties": {
            "type": {
              "const": "window.restore",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Toggle maximization of the focused window.",
          "properties": {
            "type": {
              "const": "window.toggle_maximize",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Toggle fullscreen for the focused window (no general Windows API;\nbind `keys` with F11 there).",
          "properties": {
            "type": {
              "const": "window.fullscreen",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Close the focused window. Never repeats within one gesture.",
          "properties": {
            "type": {
              "const": "window.close",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Move and resize the focused window to a half or quarter of its monitor.",
          "properties": {
            "to": {
              "$ref": "#/$defs/TileTarget"
            },
            "type": {
              "const": "window.tile",
              "type": "string"
            }
          },
          "required": [
            "type",
            "to"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Move the focused window to the next or previous monitor.",
          "properties": {
            "to": {
              "$ref": "#/$defs/Direction"
            },
            "type": {
              "const": "window.move_to_monitor",
              "type": "string"
            }
          },
          "required": [
            "type",
            "to"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Move the focused window to the next or previous workspace.",
          "properties": {
            "to": {
              "$ref": "#/$defs/Direction"
            },
            "type": {
              "const": "window.move_to_workspace",
              "type": "string"
            }
          },
          "required": [
            "type",
            "to"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Switch to the next workspace / virtual desktop.",
          "properties": {
            "type": {
              "const": "workspace.next",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Switch to the previous workspace / virtual desktop.",
          "properties": {
            "type": {
              "const": "workspace.prev",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Toggle the overview (Mission Control / Task View).",
          "properties": {
            "type": {
              "const": "overview.toggle",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        }
      ]
    },
    "Binding": {
      "additionalProperties": false,
      "properties": {
        "actions": {
          "description": "Run in order.",
          "items": {
            "$ref": "#/$defs/Action"
          },
          "type": "array"
        },
        "enabled": {
          "default": true,
          "type": "boolean"
        },
        "name": {
          "description": "What the binding is for; shown by `config check`, the tray and logs.",
          "type": [
            "string",
            "null"
          ]
        },
        "repeat": {
          "description": "Fire again every further `gesture.repeat_step`. Defaults to true when\nthe chain contains a window cycle action, false otherwise.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "trigger": {
          "$ref": "#/$defs/Trigger"
        },
        "when": {
          "anyOf": [
            {
              "$ref": "#/$defs/When"
            },
            {
              "type": "null"
            }
          ],
          "description": "Where the binding applies: app, OS, desktop. Empty/absent means\neverywhere."
        }
      },
      "required": [
        "trigger",
        "actions"
      ],
      "type": "object"
    },
    "CycleConfig": {
      "additionalProperties": false,
      "properties": {
        "include_minimized": {
          "default": true,
          "type": "boolean"
        },
        "mru_session_ms": {
          "default": 1000,
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "order": {
          "$ref": "#/$defs/Order",
          "default": "stable"
        },
        "workspace": {
          "$ref": "#/$defs/WorkspaceScope",
          "default": "all"
        }
      },
      "type": "object"
    },
    "Direction": {
      "description": "Next or previous, for monitor/workspace moves.",
      "enum": [
        "next",
        "prev"
      ],
      "type": "string"
    },
    "ExecCommand": {
      "anyOf": [
        {
          "description": "One string, run by `sh -c` (Unix) or `cmd /C` (Windows). Needs\n`\"shell\": true`.",
          "type": "string"
        },
        {
          "description": "A program and its arguments, run directly without a shell. The first\nitem is the program.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      ],
      "description": "The `command` of an [`Action::Exec`]: a program with its arguments, or a\nsingle string for the shell."
    },
    "GestureConfig": {
      "additionalProperties": false,
      "properties": {
        "repeat_step": {
          "default": 220.0,
          "description": "Further travel per extra step while the fingers stay down; 0 = one\nstep per swipe.",
          "format": "double",
          "type": "number"
        },
        "threshold": {
          "default": 120.0,
          "description": "Finger travel before a swipe counts (GNOME's full workspace swipe is 400).",
          "format": "double",
          "type": "number"
        }
      },
      "type": "object"
    },
    "HudConfig": {
      "additionalProperties": false,
      "properties": {
        "duration_ms": {
          "default": 700,
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "enabled": {
          "default": true,
          "description": "Show the window title and \"App · 2 / 5\" after each jump (on Windows,\nfrom the daemon only).",
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "Modifier": {
      "description": "A modifier as written in the config file.",
      "enum": [
        "shift",
        "ctrl",
        "alt",
        "super"
      ],
      "type": "string"
    },
    "MouseButton": {
      "description": "A mouse button a [`Trigger::Mouse`] can use.",
      "enum": [
        "left",
        "right",
        "middle",
        "back",
        "forward"
      ],
      "type": "string"
    },
    "Order": {
      "description": "How the windows of one app are ordered while cycling.",
      "oneOf": [
        {
          "const": "stable",
          "description": "Fixed order (window creation order on GNOME): next/prev walk the\nwhole list and always come back round to where they started.",
          "type": "string"
        },
        {
          "const": "position",
          "description": "Left to right on screen, then top to bottom.",
          "type": "string"
        },
        {
          "const": "mru",
          "description": "Most recently used first. A single jump toggles between the two most\nrecent windows; repeats within one [`Session`] keep digging into older\nwindows, like pressing Tab again while holding Alt.",
          "type": "string"
        }
      ]
    },
    "PinchDirection": {
      "description": "The direction of a pinch trigger.",
      "oneOf": [
        {
          "const": "in",
          "description": "Fingers move together (zoom out).",
          "type": "string"
        },
        {
          "const": "out",
          "description": "Fingers move apart (zoom in).",
          "type": "string"
        }
      ]
    },
    "ScrollDirection": {
      "description": "A wheel direction, for [`Trigger::Mouse`] with `scroll`.",
      "enum": [
        "up",
        "down",
        "left",
        "right"
      ],
      "type": "string"
    },
    "SwipeDirection": {
      "enum": [
        "left",
        "right",
        "up",
        "down"
      ],
      "type": "string"
    },
    "TileTarget": {
      "description": "Where [`Action::WindowTile`] puts the window.",
      "enum": [
        "left",
        "right",
        "top",
        "bottom",
        "top-left",
        "top-right",
        "bottom-left",
        "bottom-right"
      ],
      "type": "string"
    },
    "Trigger": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "direction": {
              "$ref": "#/$defs/SwipeDirection"
            },
            "fingers": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "modifiers": {
              "default": [],
              "items": {
                "$ref": "#/$defs/Modifier"
              },
              "type": "array"
            },
            "type": {
              "const": "swipe",
              "type": "string"
            }
          },
          "required": [
            "type",
            "fingers",
            "direction"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "keys": {
              "type": "string"
            },
            "type": {
              "const": "hotkey",
              "type": "string"
            }
          },
          "required": [
            "type",
            "keys"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A two-finger pinch in or out, optionally with modifiers held.",
          "properties": {
            "direction": {
              "$ref": "#/$defs/PinchDirection"
            },
            "fingers": {
              "default": 2,
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "modifiers": {
              "default": [],
              "items": {
                "$ref": "#/$defs/Modifier"
              },
              "type": "array"
            },
            "type": {
              "const": "pinch",
              "type": "string"
            }
          },
          "required": [
            "type",
            "direction"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Fingers resting on the touchpad without moving for a moment.",
          "properties": {
            "fingers": {
              "default": 2,
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "modifiers": {
              "default": [],
              "items": {
                "$ref": "#/$defs/Modifier"
              },
              "type": "array"
            },
            "type": {
              "const": "hold",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A modifier tapped twice quickly (Ctrl, Ctrl).",
          "properties": {
            "modifier": {
              "$ref": "#/$defs/Modifier"
            },
            "type": {
              "const": "double_tap",
              "type": "string"
            }
          },
          "required": [
            "type",
            "modifier"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A hotkey prefix followed by one key (Super+Alt+W, then M).",
          "properties": {
            "keys": {
              "description": "The prefix, in the usual hotkey syntax.",
              "type": "string"
            },
            "then": {
              "description": "One letter or digit pressed after the prefix.",
              "type": "string"
            },
            "type": {
              "const": "sequence",
              "type": "string"
            }
          },
          "required": [
            "type",
            "keys",
            "then"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A mouse button, optionally combined with scrolling that button.\nWindows only for now (Wayland does not hand buttons to the shell).",
          "properties": {
            "button": {
              "$ref": "#/$defs/MouseButton"
            },
            "modifiers": {
              "default": [],
              "items": {
                "$ref": "#/$defs/Modifier"
              },
              "type": "array"
            },
            "scroll": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ScrollDirection"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": {
              "const": "mouse",
              "type": "string"
            }
          },
          "required": [
            "type",
            "button"
          ],
          "type": "object"
        }
      ]
    },
    "When": {
      "additionalProperties": false,
      "description": "The `when` object of a binding. An empty `When` matches everything.",
      "properties": {
        "app": {
          "description": "Apps this binding applies to (glob, case-insensitive).",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "desktop": {
          "description": "`gnome`, `kde`, `sway`, `hyprland`, `niri` (or `*`).",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "not_app": {
          "description": "Apps this binding does not apply to (glob, case-insensitive).",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "os": {
          "description": "`linux`, `windows` (or `*`).",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "WorkspaceScope": {
      "description": "Which windows are candidates.",
      "oneOf": [
        {
          "const": "all",
          "description": "Windows on every workspace; jumping may switch workspace.",
          "type": "string"
        },
        {
          "const": "current",
          "description": "Only windows on the active workspace (and sticky ones).",
          "type": "string"
        }
      ]
    }
  },
  "$id": "https://raw.githubusercontent.com/hjosugi/touchpad-snap/main/schema/config.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "default": "https://raw.githubusercontent.com/hjosugi/touchpad-snap/main/schema/config.schema.json",
      "type": "string"
    },
    "bindings": {
      "default": [
        {
          "actions": [
            {
              "type": "window.next"
            }
          ],
          "enabled": true,
          "name": "Next window of this app",
          "trigger": {
            "keys": "Super+Alt+N",
            "type": "hotkey"
          }
        },
        {
          "actions": [
            {
              "type": "window.prev"
            }
          ],
          "enabled": true,
          "name": "Previous window of this app",
          "trigger": {
            "keys": "Super+Alt+P",
            "type": "hotkey"
          }
        },
        {
          "actions": [
            {
              "type": "window.next"
            }
          ],
          "enabled": true,
          "name": "Next window (Ctrl + swipe left)",
          "trigger": {
            "direction": "left",
            "fingers": 3,
            "modifiers": [
              "ctrl"
            ],
            "type": "swipe"
          }
        },
        {
          "actions": [
            {
              "type": "window.prev"
            }
          ],
          "enabled": true,
          "name": "Previous window (Ctrl + swipe right)",
          "trigger": {
            "direction": "right",
            "fingers": 3,
            "modifiers": [
              "ctrl"
            ],
            "type": "swipe"
          }
        },
        {
          "actions": [
            {
              "type": "window.next"
            }
          ],
          "enabled": true,
          "name": "Next window (Alt + swipe up)",
          "trigger": {
            "direction": "up",
            "fingers": 3,
            "modifiers": [
              "alt"
            ],
            "type": "swipe"
          }
        },
        {
          "actions": [
            {
              "type": "window.prev"
            }
          ],
          "enabled": true,
          "name": "Previous window (Alt + swipe down)",
          "trigger": {
            "direction": "down",
            "fingers": 3,
            "modifiers": [
              "alt"
            ],
            "type": "swipe"
          }
        }
      ],
      "items": {
        "$ref": "#/$defs/Binding"
      },
      "type": "array"
    },
    "cycle": {
      "$ref": "#/$defs/CycleConfig",
      "default": {
        "include_minimized": true,
        "mru_session_ms": 1000,
        "order": "stable",
        "workspace": "all"
      }
    },
    "gesture": {
      "$ref": "#/$defs/GestureConfig",
      "default": {
        "repeat_step": 220.0,
        "threshold": 120.0
      }
    },
    "hud": {
      "$ref": "#/$defs/HudConfig",
      "default": {
        "duration_ms": 700,
        "enabled": true
      }
    },
    "version": {
      "default": 2,
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    }
  },
  "title": "touchpad-snap configuration",
  "type": "object"
}
